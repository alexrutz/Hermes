# ---------------------------------------------------------------------------
# Hermes — Beispielkonfiguration
#
# Kopieren nach `.env`, ausfüllen, dann `docker compose up`.
# Alle Werte hier sind nur VORBELEGUNGEN: beim ersten Start werden sie in die
# Settings-Tabelle geschrieben, danach gewinnt immer, was in der UI eingestellt
# ist. Ausnahme sind DATA_DIR und die Ports — das sind reine Deployment-Fragen.
# ---------------------------------------------------------------------------

# --- Verbindung zur externen SGLang-Instanz --------------------------------
# Die URL des Cloudflare-Tunnels zur vast.ai-GPU, ohne abschließenden Slash.
# Das Modell läuft NICHT in diesem Compose-Stack.
SGLANG_BASE_URL=https://dein-tunnel.trycloudflare.com

# Entspricht --api-key beim Serverstart. Wird als "Authorization: Bearer <wert>"
# mitgeschickt.
SGLANG_WEB_PASSWORD=hier-dein-passwort

# Manche vast.ai-Vorlagen setzen einen eigenen Proxy davor, der einen anderen
# Header erwartet. Dann z. B. auf X-API-Key umstellen und das Schema leeren:
#   SGLANG_AUTH_HEADER=X-API-Key
#   SGLANG_AUTH_SCHEME=
SGLANG_AUTH_HEADER=Authorization
SGLANG_AUTH_SCHEME=Bearer

# Muss zu --model-path der laufenden Instanz passen.
SGLANG_MODEL=nvidia/Qwen3.6-27B-NVFP4

# Großzügig: das erste Prefill über 200k Tokens dauert Minuten, nicht Sekunden.
SGLANG_READ_TIMEOUT=1800
SGLANG_CONNECT_TIMEOUT=15
SGLANG_MAX_RETRIES=3

# --- Token-Budget -----------------------------------------------------------
# Nativer Kontext des Modells. Muss zu --context-length der Instanz passen.
MAX_CONTEXT_TOKENS=262144

# Wird vom Fenster abgezogen, bevor das Budget einer Sammlung berechnet wird:
#   budget = MAX_CONTEXT_TOKENS - RESERVED_OUTPUT_TOKENS - prompt_overhead
RESERVED_OUTPUT_TOKENS=8192

# --- Dokumentkonvertierung --------------------------------------------------
# Globaler Default. Pro Sammlung und pro Upload überschreibbar.
# Sinnvoller Bereich 72–300. Die Tokenzahl wächst quadratisch mit der DPI.
DEFAULT_PDF_DPI=150

# Downscaling nach dem Rendern. 0 = kein Limit.
DEFAULT_MAX_EDGE=2048

# png = verlustfrei, jpeg = kleiner.
DEFAULT_IMAGE_FORMAT=png
DEFAULT_JPEG_QUALITY=90
DEFAULT_GRAYSCALE=false

# --- Deployment -------------------------------------------------------------
# Im Container gemountetes Named Volume. Hier liegen SQLite-DB, Original-Uploads
# und die gerenderten Seitenbilder samt Base64. Muss persistent sein: die beim
# Ingest geschriebenen Base64-Bytes SIND der Cache-Schlüssel.
DATA_DIR=/data

FRONTEND_PORT=8080
BACKEND_PORT=8000
CORS_ORIGINS=*

# --- Monitoring-Profil (optional) ------------------------------------------
# docker compose --profile monitoring up
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=hermes

# --- Nur für den Entwicklungs-Overlay ---------------------------------------
VITE_PORT=5173
